<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Pit Stop — o histórico de manutenção dos seus carros em um só lugar.">
<title>Pit Stop — Gestão Automotiva</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%232A1B10'/%3E%3Cpath d='M6 20a3 3 0 106 0 3 3 0 00-6 0zm14 0a3 3 0 106 0 3 3 0 00-6 0zM4 20h2m18 0h2M6.5 17l2-7h15l2 7' stroke='%23D9A15B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
<script>try{var f=localStorage.getItem('pitstop-fonte');if(f)document.documentElement.style.fontSize=f;}catch(e){}</script>
<link rel="stylesheet" href="/style.css?v=7">
<style>
.lp { background: var(--paper); color: var(--black); }
.lp-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

.lp-topo { background: var(--topo); border-bottom: 4px solid var(--caramelo); }
.lp-topo .lp-wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; flex-wrap: wrap; }
.lp-marca { color: #fff; font-weight: 700; letter-spacing: .08em; font-size: 1.15rem; text-decoration: none; }
.lp-topo-acoes { display: flex; align-items: center; gap: 8px; }
.lp-entrar { min-height: 44px; padding: 8px 18px; border: 2px solid #fff; background: transparent; color: #fff; font: 700 1rem var(--sans); border-radius: var(--r-sm); cursor: pointer; }
.lp-entrar:hover { background: #fff; color: var(--black); }

.lp-abertura { padding: 56px 0 48px; border-bottom: 2px solid var(--black); }
.lp-abertura .lp-wrap { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
.lp-abertura h1 { font-size: clamp(2rem, 4.2vw, 2.9rem); line-height: 1.15; font-weight: 700; margin-bottom: 18px; }
.lp-abertura p { font-size: 1.15rem; color: var(--gray-700); max-width: 34em; margin-bottom: 28px; }
.lp-acoes { display: flex; gap: 12px; flex-wrap: wrap; }
.lp-acoes .btn { min-height: 52px; padding: 12px 24px; font-size: 1.05rem; }

/* Ficha de exemplo: mostra o produto em vez de prometer */
.ficha { background: #fff; border: 2px solid var(--black); border-radius: var(--r); }
.ficha-cab { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 18px; border-bottom: 2px solid var(--black); flex-wrap: wrap; }
.ficha-cab strong { font-size: 1.15rem; }
.ficha-cab span { font-family: var(--mono); font-size: .95rem; }
.ficha table { width: 100%; border-collapse: collapse; }
.ficha th, .ficha td { padding: 10px 14px; text-align: left; font-size: .95rem; }
.ficha td.num { font-family: var(--mono); white-space: nowrap; }
.ficha-rodape { padding: 12px 18px; border-top: 2px solid var(--black); background: #E3F1E6; color: var(--ok); font-weight: 700; }
.ficha-legenda { font-size: .9rem; color: var(--gray-600); margin-top: 10px; }

.lp-secao { padding: 56px 0; border-bottom: 1px solid var(--gray-200); }
.lp-secao h2 { font-size: 1.7rem; font-weight: 700; margin-bottom: 8px; }
.lp-secao > .lp-wrap > p { font-size: 1.1rem; color: var(--gray-700); max-width: 40em; margin-bottom: 28px; }

.lista-recursos { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; border-top: 2px solid var(--black); }
.lista-recursos div { padding: 18px 0; border-bottom: 1px solid var(--gray-200); }
.lista-recursos dt { font-weight: 700; font-size: 1.1rem; margin-bottom: 4px; }
.lista-recursos dd { color: var(--gray-700); }

.lp-leitura { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: start; background: #fff; border: 2px solid var(--black); border-radius: var(--r); padding: 28px; }
.lp-leitura .aa { font-size: 3rem; font-weight: 700; line-height: 1; border: 2px solid var(--black); border-radius: var(--r-sm); padding: 10px 14px; background: var(--caramelo); }
.lp-leitura ul { margin: 10px 0 0 1.2em; }
.lp-leitura li { margin-bottom: 6px; }

.lp-rodape { padding: 32px 0 40px; font-size: .95rem; color: var(--gray-700); }
.lp-rodape .lp-wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.lp-rodape a { color: var(--marrom); }

/* Janela de acesso */
.lp-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 500; display: none; align-items: center; justify-content: center; padding: 16px; }
.lp-modal-overlay.open { display: flex; }
.lp-modal { background: #fff; border: 2px solid var(--black); border-radius: var(--r); width: 100%; max-width: 460px; max-height: calc(100vh - 32px); overflow: auto; }
.lp-modal-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 22px; border-bottom: 2px solid var(--black); }
.lp-modal-logo { font-size: 1.3rem; font-weight: 700; }
.lp-modal-subtitle { font-size: .95rem; color: var(--gray-600); }
.lp-modal-close { min-width: 44px; height: 44px; border: 2px solid var(--gray-600); background: #fff; border-radius: var(--r-sm); font: 700 1.1rem var(--sans); cursor: pointer; }
.lp-modal-tabs { display: flex; border-bottom: 2px solid var(--gray-200); }
.lp-modal-tab { flex: 1; min-height: 52px; border: 0; background: #fff; font: 700 1rem var(--sans); color: var(--gray-700); cursor: pointer; }
.lp-modal-tab.active { color: var(--black); box-shadow: inset 0 -4px 0 var(--black); }
.lp-modal-body { padding: 22px; }
.lp-modal-hint { background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--r-sm); padding: 10px 14px; font-size: .95rem; margin-bottom: 18px; }
.lp-modal-err { color: var(--cr); font-weight: 700; margin-top: 10px; min-height: 1.5em; }
.lp-modal-switch { margin-top: 12px; text-align: center; }
.lp-modal-switch a { color: var(--marrom); }
.lp-pw-bar { height: 6px; background: var(--gray-100); border-radius: 3px; overflow: hidden; margin-top: 8px; }
.lp-pw-bar > div { height: 100%; width: 0; }

@media (max-width: 860px) {
  .lp-abertura .lp-wrap, .lista-recursos, .lp-leitura { grid-template-columns: 1fr; }
  .lp-abertura { padding-top: 36px; }
}
</style>
</head>
<body class="lp">
<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

<header class="lp-topo">
  <div class="lp-wrap">
    <a href="/" class="lp-marca">PIT STOP</a>
    <div class="lp-topo-acoes">
      <div class="fonte-ctrl" role="group" aria-label="Tamanho do texto">
        <button type="button" data-fonte="menor" aria-label="Diminuir texto">A−</button>
        <button type="button" data-fonte="normal" aria-label="Texto no tamanho padrão">A</button>
        <button type="button" data-fonte="maior" aria-label="Aumentar texto">A+</button>
      </div>
      <button class="lp-entrar" onclick="abrirLogin()">Entrar</button>
    </div>
  </div>
</header>

<main id="conteudo">
  <section class="lp-abertura" aria-labelledby="titulo">
    <div class="lp-wrap">
      <div>
        <h1 id="titulo">O caderno de manutenção do seu carro, sem nota fiscal perdida.</h1>
        <p>Anote cada troca de óleo, revisão e conserto. O Pit Stop guarda o histórico, soma quanto você já gastou e avisa quando a próxima revisão está chegando.</p>
        <div class="lp-acoes">
          <button class="btn btn-primary" onclick="abrirLogin('cadastro')">Criar conta grátis</button>
          <button class="btn btn-ghost" onclick="abrirLogin()">Já tenho conta</button>
        </div>
      </div>

      <figure>
        <div class="ficha" role="group" aria-label="Exemplo de ficha de manutenção">
          <div class="ficha-cab"><strong>Toyota Corolla 2022</strong><span>Placa TCU1A23</span></div>
          <table>
            <thead><tr><th scope="col">Data</th><th scope="col">Serviço</th><th scope="col">Km</th><th scope="col">Valor</th></tr></thead>
            <tbody>
              <tr><td class="num">16/08/2026</td><td>Troca de óleo</td><td class="num">35.000</td><td class="num">R$ 420</td></tr>
              <tr><td class="num">25/09/2026</td><td>Pastilhas de freio</td><td class="num">37.000</td><td class="num">R$ 680</td></tr>
            </tbody>
          </table>
          <div class="ficha-rodape">✓ Em dia — próxima revisão em 12/02/2027</div>
        </div>
        <figcaption class="ficha-legenda">Exemplo de como fica o histórico de um carro no Pit Stop.</figcaption>
      </figure>
    </div>
  </section>

  <section class="lp-secao" aria-labelledby="t-recursos">
    <div class="lp-wrap">
      <h2 id="t-recursos">O que o Pit Stop guarda para você</h2>
      <p>Tudo fica organizado por carro. Quem tem mais de um veículo vê cada um com o seu calendário.</p>
      <dl class="lista-recursos">
        <div><dt>Garagem</dt><dd>Seus carros com placa, ano, quilometragem e foto. Escolha o modelo no catálogo e a ficha técnica vem preenchida.</dd></div>
        <div><dt>Manutenções</dt><dd>Cada serviço com data, oficina, quilometragem e valor, do mais recente para o mais antigo.</dd></div>
        <div><dt>Revisões com laudo</dt><dd>Checklist de 20 itens e um laudo numerado para imprimir e mostrar na hora de vender o carro.</dd></div>
        <div><dt>Avisos de revisão</dt><dd>O carro aparece como em dia, revisão próxima (30 dias) ou atrasada, sempre escrito, não só pela cor.</dd></div>
        <div><dt>Gastos</dt><dd>Quanto cada carro custou por mês e no total, somado a partir do que você registrou.</dd></div>
        <div><dt>Catálogo</dt><dd>27 modelos populares no Brasil, com motor, consumo e porta-malas.</dd></div>
      </dl>
    </div>
  </section>

  <section class="lp-secao" aria-labelledby="t-leitura">
    <div class="lp-wrap">
      <div class="lp-leitura">
        <div class="aa" aria-hidden="true">A+</div>
        <div>
          <h2 id="t-leitura">Fácil de ler, para todo mundo</h2>
          <ul>
            <li>Texto grande e fonte Atkinson Hyperlegible, criada para pessoas com baixa visão.</li>
            <li>Botões A−, A e A+ no topo para ajustar o tamanho do texto; a escolha fica guardada.</li>
            <li>Contraste alto e foco do teclado sempre visível.</li>
            <li>Funciona no celular e no computador, e com leitor de tela.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="lp-rodape">
  <div class="lp-wrap">
    <span>Pit Stop · Projeto Integrador 2 · CEUB · 2026</span>
    <span>Nathan Gerken, Gustavo Pereira de Sousa e Bernardo Gontijo</span>
  </div>
</footer>

<div class="lp-modal-overlay" id="loginModal" onclick="fecharLogin(event)">
  <div class="lp-modal" onclick="event.stopPropagation()" role="dialog" aria-modal="true" aria-labelledby="lp-modal-title">
    <div class="lp-modal-header">
      <div>
        <div class="lp-modal-logo" id="lp-modal-title">Pit Stop</div>
        <div class="lp-modal-subtitle" id="lp-modal-sub">Acesse sua garagem</div>
      </div>
      <button class="lp-modal-close" onclick="fecharLogin(null)" aria-label="Fechar">✕</button>
    </div>
    <div class="lp-modal-tabs" role="tablist">
      <button class="lp-modal-tab active" id="tab-login" role="tab" onclick="mudarAba('login')">Entrar</button>
      <button class="lp-modal-tab" id="tab-cadastro" role="tab" onclick="mudarAba('cadastro')">Criar conta</button>
    </div>
    <div class="lp-modal-body" id="painel-login">
      <div class="lp-modal-hint">Para testar, use a conta de demonstração: <b>aluno</b> / <b>senha123</b></div>
      <div class="form-group">
        <label class="form-label" for="lp-us">Usuário</label>
        <input class="form-input" id="lp-us" autocomplete="username">
      </div>
      <div class="form-group">
        <label class="form-label" for="lp-pw">Senha</label>
        <input class="form-input" type="password" id="lp-pw" autocomplete="current-password">
      </div>
      <button class="btn btn-primary btn-full" id="lp-loginbtn" onclick="fazerLogin()">Entrar</button>
      <div class="lp-modal-err" id="lp-err" role="alert"></div>
      <p class="lp-modal-switch">Não tem conta? <a href="#" onclick="mudarAba('cadastro');return false;">Criar conta grátis</a></p>
    </div>
    <div class="lp-modal-body" id="painel-cadastro" style="display:none">
      <div class="form-group">
        <label class="form-label" for="cad-nome">Nome completo</label>
        <input class="form-input" id="cad-nome" autocomplete="name">
      </div>
      <div class="form-group">
        <label class="form-label" for="cad-us">Usuário</label>
        <input class="form-input" id="cad-us" autocomplete="username" aria-describedby="cad-us-ajuda">
        <div id="cad-us-ajuda" class="lp-modal-subtitle">Sem espaços, de 3 a 20 caracteres.</div>
      </div>
      <div class="form-group">
        <label class="form-label" for="cad-pw">Senha</label>
        <input class="form-input" type="password" id="cad-pw" autocomplete="new-password" aria-describedby="cad-pw-ajuda">
        <div id="cad-pw-ajuda" class="lp-modal-subtitle">Pelo menos 6 caracteres.</div>
      </div>
      <div class="form-group">
        <label class="form-label" for="cad-pw2">Confirmar senha</label>
        <input class="form-input" type="password" id="cad-pw2" autocomplete="new-password">
      </div>
      <div class="lp-pw-bar" aria-hidden="true"><div id="lp-pw-fill"></div></div>
      <button class="btn btn-primary btn-full" id="lp-cadbtn" style="margin-top:14px" onclick="fazerCadastro()">Criar minha conta</button>
      <div class="lp-modal-err" id="cad-err" role="alert"></div>
      <p class="lp-modal-switch">Já tem conta? <a href="#" onclick="mudarAba('login');return false;">Entrar</a></p>
    </div>
  </div>
</div>

<div id="toasts"></div>
<script src="/main.js?v=7"></script>
<script>
function abrirLogin(aba){
  var m=document.getElementById('loginModal');
  m.classList.add('open');
  requestAnimationFrame(function(){m.classList.add('shown');});
  mudarAba(aba||'login');
  setTimeout(function(){document.getElementById(aba==='cadastro'?'cad-nome':'lp-us').focus();},200);
}
function fecharLogin(e){
  var m=document.getElementById('loginModal');
  if(e&&e.target!==m)return;
  m.classList.remove('shown');
  setTimeout(function(){m.classList.remove('open');},200);
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')fecharLogin(null);});

function mudarAba(aba){
  var isLogin=aba==='login';
  document.getElementById('painel-login').style.display=isLogin?'block':'none';
  document.getElementById('painel-cadastro').style.display=isLogin?'none':'block';
  document.getElementById('tab-login').classList.toggle('active',isLogin);
  document.getElementById('tab-cadastro').classList.toggle('active',!isLogin);
  document.getElementById('lp-modal-sub').textContent=isLogin?'Acesse sua garagem digital':'Crie sua conta gratuita';
  document.getElementById('lp-err').textContent='';
  document.getElementById('cad-err').textContent='';
}

document.addEventListener('DOMContentLoaded',function(){
  document.getElementById('lp-pw').addEventListener('keydown',function(e){if(e.key==='Enter')fazerLogin();});
  document.getElementById('lp-us').addEventListener('keydown',function(e){if(e.key==='Enter')fazerLogin();});
  document.getElementById('cad-pw2').addEventListener('keydown',function(e){if(e.key==='Enter')fazerCadastro();});
  document.getElementById('cad-pw').addEventListener('input',function(){
    var v=this.value,s=0;
    if(v.length>=6)s++;if(v.length>=10)s++;if(/[A-Z]/.test(v))s++;if(/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;
    var fill=document.getElementById('lp-pw-fill');
    var cols=['','#E53030','#9A6700','#f0b429','#4caf50','#2e7d32'];
    fill.style.width=(s*20)+'%';fill.style.background=cols[s]||cols[1];
  });
});

async function fazerLogin(){
  var u=document.getElementById('lp-us').value.trim(),p=document.getElementById('lp-pw').value.trim();
  var err=document.getElementById('lp-err'),btn=document.getElementById('lp-loginbtn');
  if(!u||!p){err.textContent='Preencha usuário e senha.';return;}
  err.textContent='';btn.textContent='Entrando...';btn.disabled=true;
  try{
    var res=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({usuario:u,senha:p})});
    var j=await res.json();
    if(j.ok){window.location.href='/dashboard';}
    else{err.textContent='Usuário ou senha incorretos.';btn.textContent='Entrar';btn.disabled=false;}
  }catch(e){
    err.textContent='Erro de conexão. Tente novamente.';
    btn.textContent='Entrar';btn.disabled=false;
  }
}

async function fazerCadastro(){
  var nome=document.getElementById('cad-nome').value.trim();
  var u=document.getElementById('cad-us').value.trim();
  var p=document.getElementById('cad-pw').value;
  var p2=document.getElementById('cad-pw2').value;
  var err=document.getElementById('cad-err'),btn=document.getElementById('lp-cadbtn');
  if(!u||!p||!p2){err.textContent='Preencha todos os campos obrigatórios.';return;}
  if(p!==p2){err.textContent='As senhas não conferem.';return;}
  err.textContent='';btn.textContent='Criando conta...';btn.disabled=true;
  try{
    var res=await fetch('/api/cadastro',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({usuario:u,senha:p,senha2:p2,nome:nome})});
    var j=await res.json();
    if(j.ok){window.location.href='/dashboard';}
    else{err.textContent=j.msg||'Erro ao criar conta.';btn.textContent='Criar minha conta';btn.disabled=false;}
  }catch(e){
    err.textContent='Erro de conexão. Tente novamente.';
    btn.textContent='Criar minha conta';btn.disabled=false;
  }
}
</script>
</body>
</html>
