    <div class="cena__fixa">
      <div class="abertura" aria-hidden="true"><div class="abertura__faixa"></div></div>

      <div class="hero">
        <p class="hero__marca larga" aria-hidden="true"><span>P</span><span>I</span><span>T</span><span class="esp"></span><span>S</span><span>T</span><span>O</span><span>P</span></p>
        <div class="hero__vaga" aria-hidden="true"></div>
        <div class="hero__cupula" aria-hidden="true"></div>
        <div class="hero__texto">
          <h1 class="hero__titulo larga">O caderno de manutenção do seu carro, sem nota fiscal perdida.</h1>
          <div class="hero__acoes">
            <button type="button" class="botao botao--claro" onclick="abrirLogin('cadastro')"><span>Criar conta grátis</span><i class="botao__seta" aria-hidden="true"></i></button>
            <button type="button" class="botao botao--contorno" onclick="abrirLogin()"><span>Já tenho conta</span></button>
          </div>
        </div>
